package main

// BrandingPage is the admin's App setup: the app's name and logo,
// colours, currency, receipt texts and limits. static/setup.js updates the
// preview while typing.
templ BrandingPage(f BrandForm, cur Branding, errs []string, saved bool) {
	@pageHead("App setup", "The name, logo and colours everyone sees, on screens, receipts and shared images.")
	if saved {
		@okBox("Saved. Everyone sees the new setup on their next page.")
	}
	@errorBox(errs)
	<form
		id="brand-form"
		method="post"
		action="/setup/app"
		enctype="multipart/form-data"
		hx-post="/setup/app"
		hx-encoding="multipart/form-data"
		hx-disabled-elt="find button[type=submit]"
		class="grid items-start gap-x-6 lg:grid-cols-[minmax(0,1fr)_20rem]"
	>
		<div class="min-w-0">
			@sheet("Name and logo") {
				<div class="grid gap-4 sm:grid-cols-2">
					@field("App name") {
						<input name="name" value={ f.Name } maxlength="40" required data-preview="name" class={ inputCls }/>
					}
					@field("Tagline (optional)") {
						<input name="tagline" value={ f.Tagline } maxlength="40" placeholder="e.g. 4D / 3D / 2D" data-preview="tagline" class={ inputCls }/>
					}
				</div>
				<div class="mt-5">
					<span class="mb-1.5 block text-[13px] font-semibold text-muted">Logo</span>
					<div class="flex flex-wrap items-center gap-4">
						<span class="grid size-16 shrink-0 place-items-center overflow-hidden rounded-xl border border-rule bg-white p-1 text-form">
							if cur.HasLogo() {
								<img id="logo-current" src={ cur.LogoURL() } alt="Current logo" class="size-full object-contain"/>
							} else {
								@icon("ticket", "size-8")
							}
						</span>
						<div class="min-w-0 flex-1 space-y-2">
							<input
								type="file"
								name="logo"
								accept="image/png,image/jpeg,image/gif"
								data-preview="logo"
								class="block w-full text-sm text-muted file:mr-3 file:h-10 file:cursor-pointer file:rounded-lg file:border file:border-rule file:bg-white file:px-4 file:text-[15px] file:font-semibold file:text-ink hover:file:bg-form/5"
							/>
							<p class="text-[13px] text-muted">PNG, JPEG or GIF up to 1 MB. A square image works best; it sits on a white tile.</p>
							if cur.HasLogo() {
								<label class="inline-flex cursor-pointer items-center gap-2 text-sm font-semibold text-pen-dark">
									<input type="checkbox" name="remove_logo" value="1" checked?={ f.RemoveLogo } data-preview="remove" class="size-4 accent-pen"/>
									Remove the logo and use the ticket icon
								</label>
							}
						</div>
					</div>
				</div>
			}
			@sheet("Colours") {
				<div class="grid gap-4 sm:grid-cols-2">
					@colourField("Main colour", "color", f.Color, "Header, buttons and headings.")
					@colourField("Accent colour", "accent", f.Accent, "Handwritten numbers, totals and the Sell button.")
				</div>
				<p class="mt-3 text-[13px] text-muted">Both carry white text, so they must be dark enough to read (contrast 4.5:1 or more).</p>
			}
			@sheet("Money") {
				<div class="grid gap-4 sm:grid-cols-2">
					@field("Currency symbol") {
						<input name="currency" value={ f.Currency } maxlength="5" required placeholder="$" data-preview="currency" class={ inputCls }/>
					}
					@field("Symbol goes") {
						<select name="currency_pos" data-preview="currency_pos" class={ inputCls }>
							<option value="before" selected?={ f.CurrencyPos != "after" }>Before the amount ($1.50)</option>
							<option value="after" selected?={ f.CurrencyPos == "after" }>After the amount (1.50 $)</option>
						</select>
					}
				</div>
				<p class="mt-3 text-[13px] text-muted">Only the symbol changes: amounts already sold keep their value. Prices are set on the Prices page.</p>
			}
			@sheet("Receipts and results") {
				<div class="space-y-4">
					@field("Receipt note") {
						<input name="receipt_note" value={ f.ReceiptNote } maxlength="120" placeholder="e.g. Keep this receipt. It's needed to claim a prize." data-preview="note" class={ inputCls }/>
					}
					@field("Results note") {
						<input name="results_note" value={ f.ResultsNote } maxlength="160" placeholder="e.g. Draws every day at 19:00. Prizes paid within 30 days." class={ inputCls }/>
					}
					<div class="grid gap-4 sm:grid-cols-2">
						@field("Phone") {
							<input name="phone" type="tel" value={ f.Phone } maxlength="40" placeholder="+670 …" data-preview="phone" class={ inputCls }/>
						}
						@field("Address") {
							<input name="address" value={ f.Address } maxlength="120" placeholder="e.g. Rua de Comoro, Dili" data-preview="address" class={ inputCls }/>
						}
					</div>
					<p class="text-[13px] text-muted">The receipt note, phone and address go at the bottom of every receipt and ticket image. The results note, phone and address go under the results.</p>
				</div>
			}
			@sheet("Selling and sign-in") {
				<div class="grid gap-4 sm:grid-cols-3">
					@field("Lines on a new ticket") {
						<input name="start_lines" type="number" inputmode="numeric" min="1" max="20" value={ f.StartLines } required class={ inputCls }/>
					}
					@field("Most lines per ticket") {
						<input name="max_lines" type="number" inputmode="numeric" min="1" max="100" value={ f.MaxLines } required class={ inputCls }/>
					}
					@field("Stay signed in (hours)") {
						<input name="session_hours" type="number" inputmode="numeric" min="1" max="72" value={ f.SessionHours } required class={ inputCls }/>
					}
				</div>
				<p class="mt-3 text-[13px] text-muted">A new sign-in length applies from each person's next sign-in.</p>
			}
		</div>
		<aside class="lg:sticky lg:top-20">
			@brandPreview(cur)
			<div class="mt-4 flex flex-col gap-3 max-lg:mb-2">
				<button type="submit" class={ primaryBtn + " w-full" }>
					@icon("check", "size-5")
					Save setup
				</button>
				if !cur.UpdatedAt.IsZero() {
					<p class="text-center text-[13px] text-muted">Last saved { when(cur.UpdatedAt) } by { cur.UpdatedBy }</p>
				}
			</div>
		</aside>
	</form>
}

// colourField is a colour picker with the hex code next to it; the text
// field is the one sent, the picker just fills it in.
templ colourField(label, name, value, help string) {
	<div>
		<span class="mb-1.5 block text-[13px] font-semibold text-muted">{ label }</span>
		<div class="flex gap-2">
			<input type="color" value={ value } data-colour-for={ name } aria-label={ label + " picker" } class="h-11 w-14 shrink-0 cursor-pointer rounded-lg border border-rule bg-white p-1"/>
			<input name={ name } value={ value } maxlength="7" pattern="#?[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?" required spellcheck="false" autocapitalize="characters" aria-label={ label } data-preview={ name } class={ inputCls + " font-mono uppercase" }/>
		</div>
		<span class="mt-1.5 block text-[13px] text-muted">{ help }</span>
	</div>
}

// brandPreview shows a receipt header and total with the setup being
// edited. Its colours are its own CSS variables, so the preview changes
// without touching the rest of the page.
templ brandPreview(b Branding) {
	<section id="brand-preview" class="overflow-hidden rounded-2xl border border-rule bg-white" aria-label="Preview">
		<h2 class="border-b border-rule px-4 py-3 text-[15px] font-bold text-ink">Preview</h2>
		<div class="bg-paper p-4">
			<div class="overflow-hidden rounded-sm bg-white shadow-[0_1px_0_#CDD4EA,0_12px_28px_-18px_rgb(23_32_59/0.45)]">
				<div class="flex items-center justify-between gap-3 bg-form px-4 py-3 text-white">
					<div class="flex min-w-0 items-center gap-2.5">
						<span class="grid size-8 shrink-0 place-items-center overflow-hidden rounded-md bg-white p-0.5 text-form">
							<img
								id="pv-logo"
								if b.HasLogo() {
									src={ b.LogoURL() }
									data-saved={ b.LogoURL() }
								}
								alt="" class={ "size-full object-contain", templ.KV("hidden", !b.HasLogo()) }/>
							<span id="pv-icon" class={ templ.KV("hidden", b.HasLogo()) }>
								@icon("ticket", "size-5")
							</span>
						</span>
						<div class="min-w-0 leading-tight">
							<div id="pv-name" class="truncate text-lg font-extrabold [font-stretch:112%]">{ b.Name }</div>
							<div id="pv-tagline" class="truncate text-[11px] text-white/75">{ b.Tagline }</div>
						</div>
					</div>
					<div class="text-right leading-tight">
						<div class="text-[11px] text-white/75">Serial no.</div>
						<div class="text-lg font-bold tabular-nums">00042</div>
					</div>
				</div>
				<div class="flex items-end justify-between gap-3 px-4 pb-3 pt-4">
					<div class="flex gap-1">
						for _, d := range []string{"2", "8", "1", "2"} {
							<span class="grid h-9 w-7 place-items-center border border-[#9AA6CC] pt-1 font-hand text-xl leading-none text-pen">{ d }</span>
						}
					</div>
					<div class="text-right">
						<div class="text-xs font-semibold text-form">Total</div>
						<div id="pv-total" class="pt-1 font-hand text-[32px] leading-none text-pen">{ b.Money(250) }</div>
					</div>
				</div>
				<div class="border-t border-rule px-4 py-2.5 text-center text-xs leading-relaxed text-muted">
					<p id="pv-note" class="font-semibold text-form">{ b.ReceiptNote }</p>
					<p id="pv-contact">{ b.Contact() }</p>
				</div>
			</div>
			<div class="mt-3 flex gap-2">
				<span class="inline-flex h-10 flex-1 items-center justify-center rounded-lg bg-form text-sm font-semibold text-white">Button</span>
				<span class="inline-flex h-10 flex-1 items-center justify-center rounded-xl bg-pen text-sm font-bold text-white">Sell</span>
			</div>
		</div>
	</section>
}
